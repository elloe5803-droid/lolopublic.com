<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0a0a1a"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💎 Upgrade Premium"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"/>

    <!-- Paket 3 Hari -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1a2e"
        android:padding="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPaket3Hari"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paket 3 Hari — Rp 35.000"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnBeli3Hari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beli"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Paket 1 Minggu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1a2e"
        android:padding="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPaket1Minggu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paket 1 Minggu — Rp 55.000"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnBeli1Minggu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beli"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Paket 10 Hari -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1a2e"
        android:padding="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPaket10Hari"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paket 10 Hari — Rp 150.000"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnBeli10Hari"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beli"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- Paket 1 Bulan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1a1a2e"
        android:padding="16dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvPaket1Bulan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Paket 1 Bulan — Rp 150.000"
            android:textColor="#FFFFFF"/>
        <Button
            android:id="@+id/btnBeli1Bulan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Beli"
            android:backgroundTint="#00FF88"
            android:textColor="#000000"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🎫 Kode Gratis? Hubungi admin."
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"/>
</LinearLayout>
